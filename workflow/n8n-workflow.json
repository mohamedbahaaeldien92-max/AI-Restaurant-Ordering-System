      "parameters": {
        "jsCode": "const output = $input.first().json?.output ?? '';\n\n// تنظيف الـ markdown\nlet cleaned = output\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\n// استخراج JSON\nconst jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n\nlet orderData = {\n  order_confirmed: false\n};\n\nif (jsonMatch) {\n\n  try {\n\n    orderData = JSON.parse(jsonMatch[0]);\n\n    // معالجة جميع احتمالات أسماء الـ keys\n\n    orderData.order_confirmed =\n      orderData.order_confirmed ??\n      orderData.orderconfirmed ??\n      false;\n\n    orderData.customer_name =\n      orderData.customer_name ??\n      orderData.customername ??\n      '';\n\n    orderData.phone =\n      orderData.phone ??\n      '';\n\n    orderData.address =\n      orderData.address ??\n      '';\n\n    orderData.item_name =\n      orderData.item_name ??\n      orderData.itemname ??\n      orderData.itemName ??\n      '';\n\n    orderData.unit_price =\n      orderData.unit_price ??\n      orderData.unitprice ??\n      orderData.unitPrice ??\n      '';\n\n    orderData.quantity =\n      orderData.quantity ??\n      '';\n\n    orderData.discount_percent =\n      orderData.discount_percent ??\n      orderData.discountpercent ??\n      orderData.discountPercent ??\n      '';\n\n    orderData.discount_amount =\n      orderData.discount_amount ??\n      orderData.discountamount ??\n      orderData.discountAmount ??\n      '';\n\n    orderData.total_before_discount =\n      orderData.total_before_discount ??\n      orderData.totalbeforediscount ??\n      orderData.totalBeforeDiscount ??\n      '';\n\n    orderData.delivery_fee =\n      orderData.delivery_fee ??\n      orderData.deliveryfee ??\n      orderData.deliveryFee ??\n      '';\n\n    orderData.total_after_discount =\n      orderData.total_after_discount ??\n      orderData.totalafterdiscount ??\n      orderData.totalAfterDiscount ??\n      '';\n\n    orderData.final_total =\n      orderData.final_total ??\n      orderData.finaltotal ??\n      orderData.finalTotal ??\n      '';\n\n    orderData.payment_method =\n      orderData.payment_method ??\n      orderData.paymentmethod ??\n      orderData.paymentMethod ??\n      '';\n\n    orderData.notes =\n      orderData.notes ??\n      '';\n\n    orderData.timestamp =\n      orderData.timestamp ??\n      new Date().toISOString();\n\n  } catch (e) {\n\n    orderData = {\n      order_confirmed: false\n    };\n\n  }\n\n}\n\nconst tgData = $('Normalize Message').item.json;\n\n// رسالة عادية\nlet cleanReply = cleaned;\n\n// رسالة تأكيد الأوردر\nif (orderData.order_confirmed) {\n\n  cleanReply =\n`✅ تم تأكيد أوردر حضرتك يا ${orderData.customer_name}\n\n🍔 الصنف:\n${orderData.item_name}\n\n💵 سعر القطعة:\n${orderData.unit_price} جنيه\n\n🔢 الكمية:\n${orderData.quantity}\n\n🏷 الخصم:\n${orderData.discount_percent}%\n\n💸 قيمة الخصم:\n${orderData.discount_amount} جنيه\n\n💰 الإجمالي قبل الخصم:\n${orderData.total_before_discount} جنيه\n\n🚚 التوصيل:\n${orderData.delivery_fee} جنيه\n\n✅ الإجمالي بعد الخصم:\n${orderData.total_after_discount} جنيه\n\n💳 الإجمالي النهائي:\n${orderData.final_total} جنيه\n\n📍 العنوان:\n${orderData.address}\n\n🚚 التوصيل خلال 30-45 دقيقة\n\nشكراً لاختيارك دلع كرشك ❤️`;\n\n}\n\nreturn [{\n  json: {\n\n    ...orderData,\n\n    raw_output: output,\n    cleaned_output: cleaned,\n    reply_text: cleanReply,\n\n    chat_id: tgData.chatId,\n    customer_tg_name: tgData.fullName,\n    username: tgData.username,\n    message_text: tgData.rawText,\n\n    orderID: tgData.orderID,\n\n    dateISO: new Date().toISOString().split('T')[0],\n    timeISO: new Date().toTimeString().split(' ')[0],\n    isoTimestamp: new Date().toISOString()\n\n  }\n}];"
      },
