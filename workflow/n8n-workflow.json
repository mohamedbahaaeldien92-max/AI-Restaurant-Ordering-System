      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst msg = data?.message ?? {};\nconst chatId = msg?.chat?.id ?? msg?.from?.id ?? '';\nconst firstName = msg?.from?.first_name ?? 'عزيزي العميل';\nconst lastName = msg?.from?.last_name ?? '';\nconst username = msg?.from?.username ?? 'غير محدد';\nconst rawText = msg?.text ?? '';\nconst messageId = msg?.message_id ?? 0;\nconst normalizedText = rawText.toLowerCase().replace(/\\s+/g, ' ').trim();\nconst now = new Date();\nreturn [{\n  json: {\n    chatId,\n    firstName,\n    lastName,\n    fullName: (firstName + ' ' + lastName).trim(),\n    username,\n    rawText,\n    normalizedText,\n    messageId,\n    dateISO: now.toISOString().split('T')[0],\n    timeISO: now.toTimeString().split(' ')[0],\n    isoTimestamp: now.toISOString(),\n    orderID: 'ORD-' + Date.now()\n  }\n}];"
      },
      "id": "7fcb48f9-b737-46b4-8ff4-be7b920ad5fc",
      "name": "Normalize Message",
